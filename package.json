{
  "name": "@thinkr/verifier",
  "version": "0.1.0",
  "private": true,
  "description": "Verifies the enclave of the private lane of Thinkr and encrypts each request to it with EHBP.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ThinkrAI/thinkr-verifier.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "thinkr-verify": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "verify": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "dev:verify": "tsx src/cli.ts"
  },
  "dependencies": {
    "@freedomofpress/crypto-browser": "0.1.8",
    "@freedomofpress/sigstore-browser": "0.1.15",
    "@panva/hpke-noble": "1.1.7",
    "hpke": "1.1.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tinfoilsh/verifier": "1.3.0",
    "@types/node": "22.20.5",
    "ehbp": "0.4.1",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
